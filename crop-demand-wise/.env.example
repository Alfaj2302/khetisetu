# Base URL of the KhetiSetu FastAPI backend (see ../backend).
# Start it with:  ../backend/.venv/bin/python ../backend/main.py
VITE_API_BASE_URL=http://localhost:8000

# Optional bearer token. This app has no sign-in flow and never calls /auth/*,
# but the backend gates two endpoint groups behind a token:
#   /api/v1/business/*  requires role AGRI_BUSINESS or ADMIN
#   /api/v1/rag/query   requires any role
# Leave unset and those two screens show the API's 401; everything else works.
# Mint one against your database with:
#   cd ../backend && .venv/bin/python -c "from app.security import create_access_token; \
#     print(create_access_token(user_id=1, role='AGRI_BUSINESS', district_id=None))"
# VITE_API_TOKEN=
