# Copy this file to `backend/.env` and fill in your local Postgres
# credentials. Never commit the real `.env` file (it's gitignored).
#
# Debian/Ubuntu's system Python refuses a bare `pip install` (PEP 668,
# "externally-managed-environment") — always install into a venv:
#   python3 -m venv backend/.venv
#   backend/.venv/bin/pip install -r backend/requirements.txt
#
# Then create the schema, load the CSVs from /db, and start the API:
#   backend/.venv/bin/python backend/db/sync.py
#   backend/.venv/bin/python backend/main.py
#
# To run the test suite (needs the schema+seed data applied above; every
# test rolls back its own writes, so it's safe to re-run):
#   backend/.venv/bin/pip install -r backend/requirements-dev.txt
#   cd src/backend && .venv/bin/pytest

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khetisetu

# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

HOST=0.0.0.0
PORT=8000

# JWT signing key for /auth/login tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app falls back to an insecure dev default if this is unset — never
# rely on that outside a throwaway local database.
SECRET_KEY=change-me-to-a-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------
# RAG (see rag/README.md)
#
# The DEFAULT STACK COSTS NOTHING and needs no key at all for embeddings:
#   embeddings -> sentence-transformers on this machine (BAAI/bge-m3)
#   generation -> Groq's free tier (Llama 3.3 70B)
#
# Only GROQ_API_KEY is needed to get a full-quality answer, and it is free:
#   https://console.groq.com/keys
#
# Everything degrades rather than failing. GET /api/v1/rag/status reports which
# combination is live, so a weak answer is never mistaken for a missing key.
# ---------------------------------------------------------------

# --- generation: groq | ollama | anthropic ---
RAG_PROVIDER=groq

# groq (default). Free tier, no card.
GROQ_API_KEY=

# ollama: fully offline, no key. Install from https://ollama.com then:
#   ollama pull qwen2.5:3b
# Expect tens of seconds per answer on a laptop without a GPU.

# anthropic: the only backend with NATIVE CITATIONS - the API itself reports
# which passage supports each sentence, instead of the model being asked for
# quotes that are then verified against the source. Stronger guarantee, paid.
# Key: https://platform.claude.com/settings/keys
# NOTE: Claude API billing is separate from a Claude.ai / Claude Code plan -
# a subscription does not include API credits.
ANTHROPIC_API_KEY=

# Override the model or endpoint for any provider. Defaults per provider:
#   groq      https://api.groq.com/openai/v1   llama-3.3-70b-versatile
#   ollama    http://localhost:11434/v1        qwen2.5:3b
#   anthropic (n/a)                            claude-opus-5
# Any other OpenAI-compatible endpoint (OpenRouter, vLLM) works by setting
# RAG_BASE_URL and RAG_API_KEY - no code change.
# RAG_MODEL=
# RAG_BASE_URL=
# RAG_API_KEY=
RAG_MAX_TOKENS=2000
RAG_EFFORT=medium

# --- embeddings: local | voyage ---
#
# local (default) needs NO key and runs offline. bge-m3 is multilingual, which
# matters because the UI is English/Hindi/Marathi - a Marathi question has to
# match an English bulletin. Measured: a Marathi query scores 0.50 cosine
# similarity against the matching English passage, so cross-lingual retrieval
# genuinely works.
#
# First use downloads ~2.3GB and needs ~2.7GB RAM. The API preloads it in a
# background thread at startup (~24s) so no user request pays for it.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Lighter alternative if RAM is tight - NOTE 768 dims, so it needs a migration
# of document_chunks.embedding to match:
#   EMBEDDING_MODEL=intfloat/multilingual-e5-base
#   EMBEDDING_DIM=768

# voyage: hosted embeddings. https://dashboard.voyageai.com/organization/api-keys
VOYAGE_API_KEY=

# EMBEDDING_DIM must equal the model's real output width AND the width of
# document_chunks.embedding (migration 003 sets it to 1024). All three must
# agree or ingest refuses to run.

# How many chunks reach the model, and how relevance is judged.
#
# RAG_RELATIVE_MARGIN does the real filtering: keep only chunks within this
# cosine distance of the best match for that query. It is relative because what
# counts as "close" depends on the embedding model - an absolute threshold tuned
# for one model silently drops everything under another, and a retriever that
# returns nothing looks exactly like a corpus nobody ingested.
# RAG_MAX_DISTANCE is only a loose guard against the actively unrelated.
RAG_TOP_K=6
RAG_MAX_DISTANCE=0.9
RAG_RELATIVE_MARGIN=0.15
